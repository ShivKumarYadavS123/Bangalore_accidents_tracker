# Example settings for server/.env. Copy the lines you need into server/.env.
# This file only lists the BAT News Agent and X import settings; the rest of
# the server's settings are described in server/ai/README.md and
# server/emergency/README.md. Never put real keys in this file.

# ── BAT News Agent (server/agent/README.md) ─────────────────────────────────
# Searches GDELT, publisher RSS feeds and Google News RSS for new Bengaluru
# road accidents and adds them as PENDING accidents for an admin to approve.
# Set to false to turn it off completely (no scheduled runs, and the admin
# "Run now" button is disabled).
AGENT_ENABLED=true

# Hours between runs (minimum 1). The first run starts 2 minutes after startup.
AGENT_INTERVAL_HOURS=3

# Search queries, separated by |. Kannada queries use the Kannada Google News edition.
AGENT_QUERIES=Bengaluru accident|Bengaluru road accident killed|Bengaluru crash injured|Bengaluru hit-and-run|ಬೆಂಗಳೂರು ಅಪಘಾತ

# Publisher RSS feeds, separated by |. Their links go straight to the publisher,
# so the whole article is read (Google News links never reach the publisher).
# Empty means these two defaults (Bengaluru sections of The Hindu and The Times
# of India, both checked in a browser); "off" turns publisher feeds off. Only
# http(s) addresses that are not Google are used, at most 10. Feed items older
# than the search window (2 days, or the backfill days) are left out.
AGENT_RSS_FEEDS=https://www.thehindu.com/news/cities/bangalore/feeder/default.rss|https://timesofindia.indiatimes.com/rssfeeds/-2128833038.cms

# Related-story links ("Also Read" lines and related-story blocks) kept per run
# from pages the agent read. Only links on the same site whose text reads like
# a Bengaluru crash; the next run checks them like any other headline (triage,
# read, date check, duplicate check). 0 turns this off; at most 10.
AGENT_MAX_RELATED_PER_RUN=3

# Articles opened and checked per run.
AGENT_MAX_READS_PER_RUN=8

# Free AI calls the agent may use per run and per day (IST). Free OpenRouter
# models allow about 50 calls a day, shared with Ask BAT and the other AI
# features, and the agent never starts an AI step when fewer than 10 are left.
AGENT_MAX_AI_CALLS_PER_RUN=8
AGENT_DAILY_AI_BUDGET=20

# Free models the agent tries, in order (triage, extraction and Import from X).
# Paid model ids are replaced with openrouter/free.
AGENT_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free

# ── BAT Review Agent (double-checks the News Agent's pending finds) ─────────
# off | shadow | auto. shadow (the default) only records what it would do and
# never writes to the database; auto approves finds that pass every check. It
# never rejects. An admin can change the mode in Admin → News Agent; that choice
# (kept in server/data/review-state.json) wins over this value.
REVIEW_AGENT_MODE=shadow
# Free AI calls the Review Agent may use per IST day (its own budget; the
# "keep 10 site-wide calls spare" rule applies too).
REVIEW_AGENT_DAILY_AI_BUDGET=10

# ── All AI features ─────────────────────────────────────────────────────────
# OpenRouter reasoning effort sent with every request, so "thinking" models
# answer instead of spending max_tokens on reasoning. Models that don't reason
# ignore it. Values: low (default), minimal, medium, high, none, or off to send nothing.
AI_REASONING_EFFORT=low

# ── Import from X (admin paste box) ─────────────────────────────────────────
# X handles labelled "Bengaluru Traffic Police (X)", comma-separated, without @.
# Posts from any other handle are labelled "X: @handle".
X_TRAFFIC_POLICE_HANDLES=blrcitytraffic
